{
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,ascii.txt,robots.txt,sitemap.xml}"
    },
    "api/**/*.js": {
      "includeFiles": "{index.html,ascii.txt,robots.txt,sitemap.xml}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/api/$1"
    }
  ]
}
